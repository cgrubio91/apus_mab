# ============================================
# 🔑 AI CONFIGURATION (Gemini or Ollama)
# ============================================
# Options: gemini, ollama
AI_PROVIDER=gemini

# Gemini settings (default)
# Get your API key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# Ollama settings (when AI_PROVIDER=ollama)
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=qwen2.5-coder:7b

# ============================================
# 🗄️ DATABASE CONFIGURATION (MySQL)
# ============================================
# Setup local con `docker compose up -d mysql` (valores que funcionan tal cual):
#   DB_HOST=127.0.0.1 / DB_PORT=3307 / DB_NAME=interventoria
#   DB_USER=postgres  / DB_PASSWORD=postgres   (definidos en docker-compose.yml)
DB_HOST=your-db-host
# Usa 3307 si usas docker-compose (mapea 3307→3306), 3306 para conexión directa
DB_PORT=3306
DB_NAME=your-db-name
DB_USER=your-db-user
DB_PASSWORD=your-db-password
# SSL: vacío o 'prefer' en local; 'require'/'verify-ca'/'verify-full' usan ca.pem
DB_SSLMODE=
# Pool de conexiones (opcional, default min=1 max=10)
# DB_POOL_MIN=1
# DB_POOL_MAX=10
# Solo para Cloud SQL Auth Proxy (formato project:region:instance)
# CLOUD_SQL_CONNECTION_NAME=

# ============================================
# 📱 TWILIO CONFIGURATION (Optional - for WhatsApp)
# ============================================
# Get your credentials at https://console.twilio.com
ACCOUNT_SID=your-twilio-account-sid
AUTH_TOKEN=your-twilio-auth-token
FROM_WHATSAPP=whatsapp:+14155238886

# ============================================
# 🔐 AUTH (JWT)
# ============================================
# Obligatoria en producción (el servidor no arranca sin ella si ENV=production).
# Genera una con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=your-long-random-secret
# Minutos de validez del token (default 480 = 8h)
# JWT_EXPIRE_MINUTES=480

# ============================================
# 🚀 SERVER CONFIGURATION
# ============================================
PORT=10000

# Environment: development, production
# ENV=development

# CORS allowed origins (comma-separated, no spaces)
# En producción, NUNCA uses "*". Especifica orígenes exactos.
# CORS_ORIGINS=http://localhost:4200,https://your-frontend.com

# ============================================
# 🔍 REFERENCIAS EXTERNAS (SECOP II / Socrata / ANI / DANE)
# ============================================
# Todas tienen default en src/config/settings.py; descomenta solo para sobreescribir.
# SOCRATA_DOMAIN=www.datos.gov.co
# Token Socrata (opcional: sin él se usa el acceso público, con menor cuota)
# SOCRATA_APP_TOKEN=
# SECOP_DATASET_ID=jbjy-vk9h
# ANI_DATASET_ID=b9m8-fgtx
# Índices DANE para indexación temporal de precios
# DANE_ICCP_DATASET_ID=
# DANE_ICCP_SERIE=ICCP
# Listas-semilla de URLs de documentos (separadas por coma)
# IDU_URLS_SEED=
# INVIAS_URLS_SEED=

# ============================================
# 📄 LÍMITES DE ARCHIVOS Y EXTRACCIÓN
# ============================================
# Tamaño máximo de archivo subido, en bytes (default 50 MB)
# MAX_FILE_SIZE=52428800
# Caracteres máximos enviados a la IA por documento (default 500000)
# MAX_DOC_CHARS=500000
